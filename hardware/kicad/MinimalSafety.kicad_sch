(label "GND" (at 368.3 184.15 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid "c820e864-323a-40cc-9e20-21f0da2047d2"))
(text "SIROKKO: MINIMAL SAFETY CORE - 3 IC + EXISTING RELAY DRIVER" (at 30.48 20.32 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b09ddb60-1783-47af-bc44-39b5d93a2acc"))
(text "DRAFT / NOT FOR ORDER / NO POWER / NO FIRE - hierarchy INTEGRATED in root SCH; PCB/firmware NOT synchronized" (at 30.48 27.94 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "af0e08dd-acb0-4920-9a7e-13401f16e47b"))
(text "Positive ARM edge latches permission. Any CLEAR_N=0 removes permission; no automatic rearm." (at 30.48 96.52 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "9b686d3f-df34-4612-b762-f42b15200b36"))
(text "Q -> safety relay IN3; /Q -> DRV8803 nENBL(8). GLOW_CMD and FUEL_CMD stay separate." (at 30.48 104.14 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "b18d6171-9e75-4ca3-aab3-be9d3267b78d"))
(text "Process checks, timings, purge and software fault handling belong to ESP32; motor/purge power path is unchanged." (at 30.48 111.76 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "963b7ddd-7649-40b4-b039-b72aa1352889"))
(text "TPS3431 fixed WDT: 170..230ms; heartbeat falling-edge interval <=100ms. No peripheral-task heartbeat." (at 30.48 254.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "4b7be487-1461-45af-8ce9-280f91c65977"))
(text "24V loss/recovery, startup dynamics, relay ratings and full safety acceptance remain OPEN." (at 30.48 261.62 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "913d948d-0a70-450c-aeb9-d89079e1fc09"))
(text "CLEAR_N = WD_OK & RELAY_DRIVER_OK & P24_PRESENT & MCU_PERMIT"
	(at 30.48 35.56 0)
	(effects
		(font
			(size 1.27 1.27)
		)
	)
	(uuid "8b42c9e8-82dc-4068-a410-a60303495470")
)
