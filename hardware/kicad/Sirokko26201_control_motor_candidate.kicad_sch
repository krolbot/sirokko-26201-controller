-b9be-ffaa18d819f8")) (no_connect (at 251.46 66.04) (uuid "51d84140-791d-4b6f-97f4-2371d5535c31")) (no_connect (at 251.46 68.58) (uuid "9cec8265-7e75-491a-bfa5-2e2f55b66e8a")) (no_connect (at 251.46 88.9) (uuid "c0fa74ca-968c-493e-9fc6-c526c4751ebf")) (no_connect (at 251.46 91.44) (uuid "9f6a9be6-6928-4e82-a300-27195d58fde8")) (no_connect (at 251.46 93.98) (uuid "95af14ff-b5cd-4968-af57-8e72adf23ce6")) (no_connect (at 251.46 96.52) (uuid "56252091-a82b-4f38-bdf8-6be14e5b5285")) (no_connect (at 251.46 99.06) (uuid "bf3ec425-86f9-4e27-8930-61b0ed30616a")) (no_connect (at 251.46 109.22) (uuid "dd17c52d-46b3-4629-8888-d46f38381ece")) (no_connect (at 251.46 111.76) (uuid "dbdd6a9a-aa99-4111-bb3a-f635dc814198")) (no_connect (at 377.19 139.7) (uuid "9b2b5e87-2ade-4843-94ba-1f6400d35162")) (no_connect (at 427.99 139.7) (uuid "fd408a47-8c7c-47ee-96e8-b1ae9c855101")) (text "SIROKKO 262.01 - INTEGRATED MINIMAL SAFETY / DRAFT\nYD-ESP32-S3 N16R8; native hierarchical schematic candidate.\nDRAFT / NOT FOR ORDER / NO POWER / NO FIRE. PCB and firmware not yet synchronized." (at 25.4 25.4 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f1705f73-79aa-4f8d-8ed6-9f68bf3391e7")) (text "THERMOCOUPLES: J30 EXHAUST / J31 AIR - TYPE K\n9-pin MAX31856 modules; Adafruit 3263 geometry.\nVIN=3V3; 3Vo/FLT=NC; thermocouples at module terminals.\nJ12 DS18B20 unchanged. PCB pending. NO POWER / NO FLASH / NO FIRE." (at 25.4 35.56 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "798c3819-deea-418d-a655-a27ceac4b24e")) (text "TWO RELAYS: K1 GLOW; K2 CLUTCH. U11 IN1=GLOW_CMD, IN2=FUEL_CMD; IN3/IN4, ENBL and RESET tied to GND. No independent welded-contact cutoff. Motor control remains external HC160. DRAFT / NO POWER / NO FLASH / NO FIRE." (at 142.24 137.16 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a32d2430-92f6-4b14-b073-bf061508d25a")) (text "MAIN INPUT / ROOM SENSOR\nJ13: 1=VIN_RAW_24, 2=GND. Main design range 21.6..28.8V.\n5V conversion is on-board; USB/external power arbitration remains unqualified.\nJ12: 1=3V3, 2=DQ, 3=GND. Never connect raw 24V to logic terminals." (at 25.4 175.26 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a26a683b-7ac9-4a62-9c63-46d72f52b918")) (text "DEFINED INPUTS / OUTPUTS - REMOTE CONTROL ONLY\nR1: room-sensor pull-up; R2/R3: thermocouple CS pull-ups.\nR7/R8: fan/PWM pulldowns. Relay driver resistors remain inside MinimalSafety.\nNo display, encoder or Start/Stop button. Their six former DevKit pins are NC.\nRemote commands are handled by ESP32; no new control connector is added.\nFirmware and remote link-loss behavior remain to be implemented and tested." (at 25.4 269.24 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5da8c089-5e3e-4b0a-bcf2-bfc0b44e5dce")) (text "REMOTE CONTROL / MAIN-POWER MONITOR - DRAFT\nU20 monitors P24 presence; USB power paths remain unqualified.\nExternal watchdog/latch and hardware ARM_PULSE logic have been removed.\nDo not restore obsolete permission circuitry. No physical tests performed." (at 210.82 254.0 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0efdce91-6b1b-4bc4-9ca6-cddffc2f92e4")) (text "DRAFT: LM5013 5V is assigned to +5V_DEVKIT in this hierarchy. USB reverse-feed arbitration remains UNQUALIFIED. NO POWER." (at 430 35 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "33efe872-0624-43e1-a6dd-3bb54058eb20")) (text "J27 GLOW: 1=switched positive; 2=power GND.\nSchematic assigned; PCB current/transient qualification OPEN. NO POWER / NO FIRE." (at 25.4 320.04 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ac24e33c-f203-43d5-9433-4ef406c30914")) (text "J28 CLUTCH: 1=switched positive; 2=power GND.\nSchematic assigned; PCB current/transient qualification OPEN. NO POWER / NO FIRE." (at 25.4 335.28 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "520582ff-6e87-42ea-aea6-55c4951d1894")) (text "RELAY DRIVER DRAFT / NO POWER / NO FLASH / NO FIRE\nU11 DRV8803: GLOW_CMD to IN1; FUEL_CMD to IN2; IN3/IN4, nENBL and RESET to GND.\nExactly K1 glow and K2 clutch; no independent welded-contact cutoff.\nDriver, relay-coil, transient and thermal qualification remain open." (at 330.2 233.68 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c6122bfe-2256-4882-8660-903a9cd09c0b")) (text "NO LOCAL USER CONTROLS / DRAFT\nNo display, Start/Stop, encoder or separate RESET on this carrier.\nNo replacement UI header, jumper or local arming control.\nOld external watchdog/latch circuitry is not restored.\nDevKit built-in EN/BOOT and USB programming circuitry are unchanged.\nNo automatic heater restart after reset or a restored remote link." (at 25.4 375.92 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "34ed548b-0f50-4a2d-ab13-32d8843af3de")) (sheet (at 430.53 20.32) (size 25.4 10.16) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (fields_autoplaced yes) (stroke (width 0.1524) (type solid)) (fill (color 0 0 0 0.0)) (uuid "803a47a9-bc89-4fae-91f4-92180f46587a") (property "Sheetname" "LOGIC_POWER_24_TO_5V__DRAFT_NOT_FOR_ORDER" (at 430.53 19.6084 0) (effects (font (size 1.27 1.27)) (justify left bottom))) (property "Sheetfile" "logic_power_24_5_DRAFT.kicad_sch" (at 430.53 31.0646 0) (effects (font (size 1.27 1.27)) (justify left top))) (pin "P24_PROTECTED" input (at 430.53 22.86 180) (uuid "4db11d82-44d6-41b1-816b-5fbf8d695125") (effects (font (size 1.27 1.27)) (justify left))) (pin "GND" passive (at 430.53 25.4 180) (uuid "677e42e8-27db-42d6-ba59-01d219c8dc88") (effects (font (size 1.27 1.27)) (justify left))) (instances (project "Sirokko26201_control" (path "/d7270d3f-3491-4796-ae0a-c336632ea3f7" (page "2"))))) (sheet (at 430.53 40.64) (size 25.4 10.16) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (fields_autoplaced yes) (stroke (width 0.1524) (type solid)) (fill (color 0 0 0 0.0)) (uuid "738f1eb5-5037-42a1-995a-b2820277f936") (property "Sheetname" "MOTOR_EXTERNAL_HC160" (at 430.53 39.9284 0) (